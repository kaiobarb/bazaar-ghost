{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bazaarghost-validation",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "validation",
    "BUILD_COMMIT": "unreleased",
    "PUBLIC_URL": "https://bazaarghost-validation.kaio-8df.workers.dev",
    "OUTBOUND_ENABLED": "false",
    "AUTH_ENABLED": "true",
    "CORS_ORIGINS": "https://bazaarghost-validation.kaio-8df.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bazaarghost-validation",
      "database_id": "4159adb1-b0af-4a3e-9a0c-755dfe5d822c",
      "migrations_dir": "worker/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DETECTIONS",
      "bucket_name": "bazaarghost-validation-detections"
    },
    {
      "binding": "LOGS",
      "bucket_name": "bazaarghost-validation-logs"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "bazaarghost-validation-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "bazaarghost-validation-jobs",
        "max_batch_size": 1,
        "max_retries": 5,
        "dead_letter_queue": "bazaarghost-validation-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "account_id": "8df695f5ca97195e8c6f4896b81be028"
}
