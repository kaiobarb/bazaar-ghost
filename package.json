{
  "name": "bazaarghost-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --test-scheduled",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file worker/fixtures/seed.sql",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@types/node": "26.4.1",
    "typescript": "7.0.2",
    "vitest": "4.1.0",
    "wrangler": "4.129.0"
  },
  "engines": {
    "node": ">=24"
  }
}
