{
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-explicit-any"]
    }
  },
  "tasks": {
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno lint && deno fmt --check"
  }
}
